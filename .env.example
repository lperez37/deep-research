# Required: comma-separated Tavily API keys
TAVILY_API_KEYS=tvly-key1,tvly-key2

# Monthly credit limit per key (free tier = 1000)
CREDITS_PER_KEY=1000

# Hours to skip a key after Tavily returns 429 on it (default 24).
# Survives monthly rollover so a stale 429 doesn't lock the key out of the
# new period — we re-probe after the cooldown expires.
COOLDOWN_HOURS=24

# Key selection: round-robin (default)
ROUTING_STRATEGY=round-robin

# SQLite database path for credit tracking
DB_PATH=/data/credits.db

# Tavily API base URL (change for testing/mocking)
TAVILY_BASE_URL=https://api.tavily.com

# MCP transport: stdio (default) | http | sse
TRANSPORT=stdio
HOST=0.0.0.0
PORT=8000

# Required for HTTP/SSE. Stdio does not require a token.
AUTH_TOKEN=

# Explicit development-only override for unauthenticated HTTP/SSE.
ALLOW_UNAUTHENTICATED_HTTP=false

# Trust the first X-Forwarded-For address for requester attribution.
# Enable only when all traffic passes through a trusted reverse proxy.
TRUST_PROXY_HEADERS=false

# Audit privacy, retention, and fail-open lock-wait limits.
AUDIT_MAX_TEXT_CHARS=8192
AUDIT_RETENTION_DAYS=90
AUDIT_BUSY_TIMEOUT_SECONDS=0.1

# Per-MCP-session circuit breaker for metered Tavily calls (0 disables).
SESSION_BURST_LIMIT=5
SESSION_BURST_WINDOW_SECONDS=60

# Optional fallback for tavily-search after every Tavily key is unavailable.
# Credentials are required only when FALLBACK_ENABLED=true.
FALLBACK_ENABLED=false
DATAFORSEO_AUTH=
DATAFORSEO_BASE_URL=https://api.dataforseo.com/v3
DATAFORSEO_LOCATION_NAME=Amsterdam,North Holland,Netherlands
JINA_SCRAPER_BASE_URL=http://100.119.183.110:9567
FALLBACK_CONTENT_MAX_CHARS=12000
# Aggregate Jina content budget shared across extracted URLs.
FALLBACK_EXTRACT_TOTAL_MAX_CHARS=6000
FALLBACK_DAILY_COST_LIMIT_USD=1.00
FALLBACK_MAX_CONCURRENCY=2
FALLBACK_MAX_COST_PER_SEARCH_USD=0.02
JINA_MAX_RESPONSE_BYTES=1100000
REQUEST_LIMIT_PER_MINUTE=60

# Bind to localhost by default. Set this to the host's Tailnet address for
# remote Tailnet-only access without exposing the MCP port publicly.
BIND_HOST=127.0.0.1
